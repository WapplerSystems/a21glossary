{
    "name": "wapplersystems/a21glossary",
    "description": "automatic conversion of all abbreviations and acronyms in the special tags for accessibility issues",
    "type": "typo3-cms-extension",
    "homepage": "https://github.com/WapplerSystems/a21glossary",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "typo3",
        "TYPO3 CMS",
        "Glossary"
    ],
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "issues": "https://github.com/WapplerSystems/a21glossary/issues",
        "source": "https://github.com/WapplerSystems/a21glossary"
    },
    "require": {
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\A21glossary\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "a21glossary"
        }
    }
}
